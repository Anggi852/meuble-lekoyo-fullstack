# Port server Express
PORT=4000
NODE_ENV=development

# URL Front-End yang diizinkan oleh CORS (pisahkan koma jika lebih dari satu)
CORS_ORIGIN=http://localhost:5173

# Password login Dashboard Owner & secret penandatangan token
ADMIN_PASSWORD=lekoyo2026
AUTH_SECRET=meuble-lekoyo-jambi-secret-key-2026

# Database persisten PostgreSQL / Neon (opsional saat dev lokal).
# Jika dikosongkan, backend otomatis menyimpan data persisten ke backend/data/database.json.
# Contoh Neon: postgresql://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Integrasi layanan Gen AI (FastAPI / Flask dari tim Gen AI) — dipanggil melalui Backend
GENAI_API_URL=
GENAI_API_KEY=
GENAI_TIMEOUT_MS=12000

# Integrasi layanan Data Science (Streamlit / REST API dari tim DS)
STREAMLIT_DASHBOARD_URL=
DS_API_URL=
